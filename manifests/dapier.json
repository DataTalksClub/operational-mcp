{
  "version": 1,
  "namespace": "dapier",
  "description": "Inspect and control Dapier through its CLI.",
  "commands": [
    {
      "path": [
        "catalog"
      ],
      "description": "Describe integrations",
      "read": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "positional": [],
      "flags": {},
      "output": "text"
    },
    {
      "path": [
        "overview"
      ],
      "description": "Inspect one overview section",
      "read": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "required": []
      },
      "positional": [],
      "flags": {
        "section": {
          "field": "section",
          "kind": "value"
        }
      },
      "output": "text"
    },
    {
      "path": [
        "runs",
        "show"
      ],
      "description": "Inspect one workflow run",
      "read": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "required": [
          "id"
        ]
      },
      "positional": [
        "id"
      ],
      "flags": {},
      "output": "text"
    },
    {
      "path": [
        "runs",
        "cancel"
      ],
      "description": "Cancel a workflow run",
      "read": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "required": [
          "id"
        ]
      },
      "positional": [
        "id"
      ],
      "flags": {},
      "output": "text"
    }
  ]
}