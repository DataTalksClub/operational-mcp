{
  "version": 1,
  "namespace": "aisl",
  "description": "Inspect AI Shipping Labs through its CLI.",
  "commands": [
    {
      "path": [
        "hosts",
        "list"
      ],
      "description": "List event hosts",
      "read": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "positional": [],
      "flags": {},
      "output": "json"
    },
    {
      "path": [
        "hosts",
        "get"
      ],
      "description": "Read an event host",
      "read": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "required": [
          "slug"
        ]
      },
      "positional": [
        "slug"
      ],
      "flags": {},
      "output": "json"
    },
    {
      "path": [
        "content",
        "get"
      ],
      "description": "Read synced content",
      "read": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "required": [
          "content_id"
        ]
      },
      "positional": [
        "content_id"
      ],
      "flags": {},
      "output": "json"
    }
  ]
}